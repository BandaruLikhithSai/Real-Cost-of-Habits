{
  "services": {
    "server": {
      "root": "server",
      "entrypoint": "src/index.js"
    },
    "client": {
      "root": "client"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "server"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "client"
      }
    }
  ]
}
